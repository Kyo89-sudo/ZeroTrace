#include <windows.h>
#include "resource.h"
IDI_APP ICON "ZeroTrace.ico"
IDI_TB_UNINSTALL ICON "icons/tb_uninstall.ico"
IDI_TB_FORCE     ICON "icons/tb_force.ico"
IDI_TB_TRACES    ICON "icons/tb_traces.ico"
IDI_TB_REFRESH   ICON "icons/tb_refresh.ico"
IDI_TB_VIEW      ICON "icons/tb_view.ico"
IDI_TB_FOLDER    ICON "icons/tb_folder.ico"
