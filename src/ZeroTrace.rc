    BLOCK "041004B0"
    BEGIN
      VALUE "FileDescription", "ZeroTrace - Disinstallazione completa"
      VALUE "ProductName", "ZeroTrace"
      VALUE "FileVersion", "1.1.0"
      VALUE "ProductVersion", "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
